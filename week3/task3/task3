module spi_master(input  logic       clk,
                  input  logic       reset,
                  input  logic       start,
                  input  logic [7:0] data_in,
                  input  logic       MISO,
                  output logic       MOSI,
                  output logic       sck,
                  output logic       done);

 
  logic [7:0] t_reg;
  logic [7:0] r_reg;
  logic [2:0] bit_count;
  logic    busy;
  assign MOSI = t_reg[7];
  
  always_ff@(posedge clk, posedge reset)
  begin
    if (reset) begin
        t_reg    <= '0;
        r_reg    <= '0;
        bit_count <= '0;
        sck    <=  0;
        busy   <= 1'b0;
        done      <= 1'b0;
    end

    else if (start) begin
        t_reg    <= data_in;
        r_reg    <= '0;
        bit_count <= '0;
        busy   <=  1'b1;
        done      <=  1'b0;
    end
     
    else if(busy == 1'b1) begin
        sck <= ~sck;
      if(sck) begin
         t_reg <= {t_reg[6:0], 1'b0};
         bit_count <= bit_count + 3'b001;    
       if (bit_count == 3'b111) begin
          done <= 1'b1;
          busy <= 1'b0;
       end
      end
      else begin
        r_reg <= {r_reg[6:0], MISO};
      end
    end
  end
  
endmodule
